# Reached only through mvm-agent's WebSocket bridge (:2222 -> 127.0.0.1:22).
ListenAddress 127.0.0.1
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
PermitRootLogin no
AllowUsers dev
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
# AL2023's OpenSSH requires PAM; authentication is still pubkey-only. PAM also loads /etc/environment.
UsePAM yes
PrintMotd no
AllowTcpForwarding yes
AllowAgentForwarding no
X11Forwarding no
AcceptEnv LANG LC_* COLORTERM TERM_PROGRAM
ClientAliveInterval 30
Subsystem sftp /usr/libexec/openssh/sftp-server
